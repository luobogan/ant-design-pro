#blade配置
blade:
  # 账号默认初始密码（可配置；对齐ChgPasswdReminder）。重置密码 / Excel 导入用户时使用。
  default-password: "123456"
  datasource:
    dev:
      url: jdbc:mysql://localhost:3306/blade?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8mb4
      username: root
      password: 123456
    order:
      url: jdbc:mysql://localhost:3306/blade_order?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8mb4
      username: root
      password: 123456
    pay:
      url: jdbc:mysql://localhost:3306/blade_pay?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8mb4
      username: root
      password: 123456
    workflow:
      url: jdbc:mysql://localhost:3306/blade_workflow?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8mb4
      username: root
      password: 123456
  upload-path: d:\workproject\springbladeandreact\springBlade\uploads

  # =============================================
  # 文件上传统一配置（所有服务共用）
  # =============================================
  file:
    # 是否启用增强功能（加密、压缩、数据库存储）
    enabled: true
    # 统一上传目录
    upload-dir: upload
    # 是否ZIP压缩（true=所有上传的文件都会压缩成zip格式）
    zip-enabled: true
    # 是否AES加密（true=所有上传的文件都会AES加密）
    encrypt-enabled: false
    # 是否保存到ImageFile数据库表（true=所有文件元数据存入ImageFile表）
    save-to-db: true
    # 图片尺寸压缩（仅对图片生效，减小图片分辨率/质量）
    image-compress: true

  auth:
    #使用 @org.springblade.test.Sm2KeyGenerator 获取,用于国密sm2验签,需和前端保持一致
    public-key: 04ac02fe94f4cac62a57a2335cc96a075a1ee41cea3b211bd7acbb9cf579b7e601b9ece2b0cfab64dca268b6942bf556af67cfe226a5cf28d936039c43e4bb12c1
    #使用 @org.springblade.test.Sm2KeyGenerator 获取,用于国密sm2解密,前端无需配置
    private-key: 00ac7fde22ecf5a764ea69b7ca8205383d98e7459e765bc1bd092f62c5f85267f9
  token:
    #使用 @org.springblade.test.SignKeyGenerator 获取
    sign-key: qHJlcyzQ7YoGmHA7wZzvioTKYzYMaugG
    #使用 @org.springblade.test.SignKeyGenerator 获取
    aes-key: hJtodEd1qzJX9UOB9RBFdWk9KrAb59fH
  xss:
    enabled: true
    skip-url:
      - /weixin
      # 富文本（TinyMCE）表单值/审批意见经 POST body 下发，不能被 XSS 过滤器清洗
      # （XssHtmlFilter 白名单仅 a/b/em/i/img/strong，<p>/<br>/<table> 等会被剥掉）
      # blade-formmode：表单数据 / 业务数据写入（Feign 直连，无 /api 前缀）
      - /form-data/**
      # blade-workflow：发起(意见+表单值) / 审批(意见+变量) / 测试提交
      - /instance/**
      - /task/**
      - /test/**
      # blade-workflow：表单保存与校验（body 含布局字段值与富文本）
      - /form/**
      # blade-workflow：BPMN XML 与节点/出口/权限配置（含 XML 标签，被清洗会破坏定义）
      - /definition/**
      # blade-workflow：自定义操作（意见文本）
      - /custom-operation/**
      # blade-workflow：子流程操作（说明文本）
      - /subflow/**
  secure:
    skip-url:
      - /test/**
      - /blade-mall/front/**
      - /blade-mall/uploads/**
      - /blade-mall/file/download/**
      - /blade-mall/auth/**
      - /blade-mall/upload/**
      - /file/download/**
      - /front/**
      - /uploads/**
      - /auth/**
    client:
      - client-id: sword
        path-patterns:
          - /sword/**
      - client-id: saber
        path-patterns:
          - /saber/**
      - client-id: sword
        path-patterns:
          - /blade-mall/front/**
  tenant:
    column: tenant_id
    tables:
      - blade_notice

